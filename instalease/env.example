# ============================================================================
# InstalEase Environment Configuration
# ============================================================================
# INSTRUCTIONS:
# 1. Copy this file to .env.local: cp env.example .env.local
# 2. Replace all placeholder values with your actual credentials
# 3. Never commit .env.local to Git (it's in .gitignore)
# 4. For production, set these in Vercel Dashboard → Environment Variables
# ============================================================================

# ============================================================================
# SUPABASE CONFIGURATION
# ============================================================================
# Get these from: https://app.supabase.com/project/_/settings/api
# Required for: Database, Authentication, Storage, Realtime

# Supabase Project URL
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Anonymous Key (Public - Safe for client-side)
# This key is safe to expose as RLS policies protect your data
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Supabase Service Role Key (PRIVATE - Server-side only!)
# ⚠️ NEVER expose this in client-side code - it bypasses RLS
# Use only in API routes and server-side code
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# ============================================================================
# TWILIO CONFIGURATION (SMS/WhatsApp Notifications)
# ============================================================================
# Get these from: https://console.twilio.com/
# Required for: Automated SMS and WhatsApp reminders

# Twilio Account SID
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here

# Twilio Auth Token
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here

# Twilio Phone Number (format: +1234567890)
# This is the number that will send SMS/WhatsApp messages
TWILIO_PHONE_NUMBER=+1234567890

# ============================================================================
# EMAIL CONFIGURATION (Nodemailer)
# ============================================================================
# Required for: Email reminders and notifications
# For Gmail: Use App Password (not regular password)
# Get App Password: https://myaccount.google.com/apppasswords

# SMTP Server Host
SMTP_HOST=smtp.gmail.com

# SMTP Server Port (587 for TLS, 465 for SSL)
SMTP_PORT=587

# SMTP Username (usually your email address)
SMTP_USER=your_email@gmail.com

# SMTP Password (App Password for Gmail)
SMTP_PASSWORD=your_app_password_here

# ============================================================================
# PAYMENT GATEWAY CONFIGURATION
# ============================================================================

# ----------------------------------------------------------------------------
# JazzCash Configuration
# ----------------------------------------------------------------------------
# Get these from: https://sandbox.jazzcash.com.pk/ (Sandbox) or Production Portal
# Required for: JazzCash payment processing

# JazzCash Merchant ID
JAZZCASH_MERCHANT_ID=your_jazzcash_merchant_id_here

# JazzCash Password
JAZZCASH_PASSWORD=your_jazzcash_password_here

# JazzCash Integrity Salt (for secure hash generation)
JAZZCASH_INTEGRITY_SALT=your_jazzcash_integrity_salt_here

# ----------------------------------------------------------------------------
# EasyPaisa Configuration
# ----------------------------------------------------------------------------
# Get these from: https://easypay.easypaisa.com.pk/easypay-merchant/
# Required for: EasyPaisa payment processing

# EasyPaisa Store ID
EASYPAISA_STORE_ID=your_easypaisa_store_id_here

# EasyPaisa Hash Key (for secure hash generation)
EASYPAISA_HASH_KEY=your_easypaisa_hash_key_here

# ----------------------------------------------------------------------------
# Raast Configuration
# ----------------------------------------------------------------------------
# Get these from your bank partner (e.g., Allied Bank)
# Required for: Raast instant payment processing

# Raast API Key
RAAST_API_KEY=your_raast_api_key_here

# Raast API Secret
RAAST_API_SECRET=your_raast_api_secret_here

# Raast API URL (default provided, override if needed)
RAAST_API_URL=https://api.raast.bank.com/v1/payments

# ============================================================================
# SENTRY ERROR TRACKING
# ============================================================================
# Get these from: https://sentry.io/settings/projects/
# Required for: Production error monitoring and tracking
# Optional: Can be left empty for development

# Sentry DSN (Data Source Name) - Public
NEXT_PUBLIC_SENTRY_DSN=https://xxx@xxx.ingest.sentry.io/xxx

# Sentry DSN (Server-side)
SENTRY_DSN=https://xxx@xxx.ingest.sentry.io/xxx

# Sentry Organization Slug
SENTRY_ORG=your_sentry_org_slug

# Sentry Project Slug
SENTRY_PROJECT=your_sentry_project_slug

# Sentry Auth Token (for releases and source maps)
SENTRY_AUTH_TOKEN=your_sentry_auth_token_here

# ============================================================================
# APPLICATION CONFIGURATION
# ============================================================================

# Application Version (for release tracking)
# Update this with each release (e.g., 1.0.0, 1.0.1, etc.)
NEXT_PUBLIC_APP_VERSION=1.0.0

# Node Environment
# Options: development, production, test
# Set to 'development' for local dev, 'production' for production
NODE_ENV=development

# ============================================================================
# OPTIONAL CONFIGURATION
# ============================================================================

# Base URL (for API callbacks and webhooks)
# Leave empty to auto-detect, or set explicitly
# NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Realtime Configuration (optional)
# Events per second limit for realtime subscriptions
# NEXT_PUBLIC_REALTIME_EVENTS_PER_SECOND=10

# ============================================================================
# DEVELOPMENT NOTES
# ============================================================================
#
# 1. LOCAL DEVELOPMENT:
#    - Copy this file: cp env.example .env.local
#    - Replace all placeholder values with your actual credentials
#    - Set NODE_ENV=development
#
# 2. PRODUCTION DEPLOYMENT:
#    - Do NOT commit .env.local to Git
#    - Set all variables in Vercel Dashboard → Environment Variables
#    - Set NODE_ENV=production
#
# 3. TESTING:
#    - Use sandbox/test credentials for payment gateways
#    - Use a separate Supabase project for testing
#    - Set NODE_ENV=test
#
# 4. SECURITY:
#    - Never commit secrets to Git
#    - Rotate keys regularly
#    - Use different keys for dev/staging/production
#    - Never expose SUPABASE_SERVICE_ROLE_KEY in client code
#
# 5. QUICK START:
#    - Minimum required: Supabase URL and Anon Key
#    - Payment gateways can be added later
#    - Notifications (Twilio/SMTP) can be added later
#    - Sentry is optional for development
#
# ============================================================================
